# Server-side Next.js -> local Python adapter. Never commit secrets here.
LOCAL_AGENT_API=http://127.0.0.1:8000

# Browser-side screenshot fallback endpoint.
NEXT_PUBLIC_LOCAL_AGENT_API=http://127.0.0.1:8000

# Optional: reuse Browser Use Web UI's proven noVNC stack for the live browser panel.
# Leave unset when running the native Windows browser path.
# When enabled, noVNC will ask for the VNC password configured in Docker Compose.
NEXT_PUBLIC_NOVNC_URL=http://127.0.0.1:6080/vnc.html?autoconnect=true&resize=scale

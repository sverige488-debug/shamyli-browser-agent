# SHAMYLI Browser Agent — local runtime environment
# Copy this file to .env and add only the provider keys you use.
# Never commit the real .env file.

# Native Browser Use LLM providers used by the modern SHAMYLI UI.
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional local Ollama host. The UI can also override this per saved LLM setting.
OLLAMA_HOST=http://127.0.0.1:11434

# Browser settings
BROWSER_PATH=
BROWSER_USER_DATA=
USE_OWN_BROWSER=false
KEEP_BROWSER_OPEN=true
BROWSER_HEADLESS=false
DISABLE_SECURITY=false
BROWSER_CDP=

# Display / Docker noVNC settings
RESOLUTION=1920x1080x24
RESOLUTION_WIDTH=1920
RESOLUTION_HEIGHT=1080
VNC_PASSWORD=shamyli-local
SHAMYLI_LIVE_BROWSER_URL=http://127.0.0.1:6080/vnc.html?autoconnect=true&resize=scale

# Browser Use runtime
ANONYMIZED_TELEMETRY=false
BROWSER_USE_LOGGING_LEVEL=info

# Optional MCP secrets
# Do NOT put MCP secret values in the browser UI. Put values here under normal
# environment-variable names, then enter only those NAMES in the MCP settings UI.
# Example:
# GITHUB_TOKEN=
# SOME_SERVICE_API_KEY=
#
# Native Windows runs load this root .env directly. Docker only receives variables
# explicitly passed into docker-compose.local-agent.yml; add any Docker-only MCP
# secret there as an environment mapping if that external server requires it.

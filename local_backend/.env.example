# Pick only the provider keys you actually use. Never commit real keys.
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Browser settings reused from Browser Use Web UI's existing contract.
BROWSER_PATH=
BROWSER_USER_DATA=
KEEP_BROWSER_OPEN=true
USE_OWN_BROWSER=false
BROWSER_CDP=
RESOLUTION_WIDTH=1920
RESOLUTION_HEIGHT=1080

# Thin local-adapter switches for Web UI settings that were previously GUI-only.
BROWSER_HEADLESS=false
DISABLE_SECURITY=false

# Optional live browser URL. Docker Compose sets this to the reused noVNC stack.
# Native Windows runs normally leave it empty and use BrowserSession screenshot fallback.
SHAMYLI_LIVE_BROWSER_URL=
